# 线上后端环境变量样例，部署时复制为 /opt/jobgraph/backend/.env 并填入真实取值。
#
# 本文件不含任何真实密钥，可入库。/opt/jobgraph/backend/.env 含密钥，
# 权限须设为 600 且属主为 jobgraph，不得回传至仓库。
#
# 与 backend/.env.example 的差别仅在三处：CORS 来源改为线上域名、
# 本机来源正则置空、抽取超时按 Nginx 的读超时对齐。其余项的含义见该文件。

# ---- 模型 ----
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=65536
LLM_VERIFIER_PARALLELISM=6
LLM_PROFICIENCY_PARALLELISM=6
LLM_SELECTOR_BATCH_SIZE=0
LLM_SELECTOR_PARALLELISM=4

# ---- 判定阈值 ----
MATCHING_DECISION_THRESHOLD=0.380952

# ---- 跨域 ----
# 前后端同域发布，浏览器不会发出跨域请求，此项仅作为直接调用接口时的白名单。
# 须与实际域名逐字一致，含协议、不含末尾斜杠。
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# 开发期放行本机任意端口的正则在公网环境无意义，置空以收紧。
CORS_ORIGIN_REGEX=

# ---- 请求控制 ----
# 该值须小于 Nginx 的 proxy_read_timeout（1800 秒），使超时由后端先行返回，
# 从而给出可读的错误而非网关截断。
CANDIDATE_REQUEST_TIMEOUT=1500
MAX_RESUME_BYTES=10485760
