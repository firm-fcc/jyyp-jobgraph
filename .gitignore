# 图谱构建管线
# 原始数据集与运行产物（体量以 GB 计，由 settings.yaml 配置路径）
pipeline/data/
pipeline/codes/*/output/
pipeline/codes/extractor/cache/
pipeline/codes/api-key.txt
# 体系构建的断点与日志（可重新生成；体系文件本身入库）
pipeline/classify/*/builder_log.*
pipeline/classify/*/*_checkpoint.json
pipeline/classify/backup/
# 三源增量层的信号数据（由管线按窗口生成，单文件以十兆计）
pipeline/classify/DeltaG/
# 单元测试的中间数据（报告本身入库）
pipeline/unit-tests/.coverage*
pipeline/unit-tests/.test-results.xml
pipeline/unit-tests/.live-observations.json
# 数据迁移包
graph_data_bundle_*.zip
