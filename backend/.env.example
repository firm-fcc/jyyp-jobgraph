# Deployment-only LLM settings used by resume extraction and optional auto proficiency.
# The deployer copies this template to local .env and fills it there.
# Never put real values in this example or include local .env in a delivery archive.
LLM_API_KEY=
LLM_MODEL=
# Preferred: full OpenAI-compatible /chat/completions endpoint
LLM_API_URL=
# Or set base, e.g. https://provider.example/v1
LLM_API_BASE=
LLM_TIMEOUT=90
# Output budget per model request. Reasoning models bill their chain of thought
# to completion_tokens, so it counts against this budget too; measured chains run
# several times longer than the answer itself. When the budget runs out the
# provider returns empty content with finish_reason="length" and the extraction
# fails. Leave blank for the 32768 default.
LLM_MAX_OUTPUT_TOKENS=32768
# Concurrent model requests. Evidence-Skill verification and proficiency grading
# both judge one item at a time with no ordering between items, so issuing them
# serially makes the stage cost the sum of every call; reasoning models take tens
# of seconds per item and the item count varies with resume length, leaving those
# stages without a predictable upper bound. Set either to 1 to go back to serial.
LLM_VERIFIER_PARALLELISM=6
LLM_PROFICIENCY_PARALLELISM=6
# Evidence units per semantic-recall batch; 0 sends them all in one call. A single
# full call has to weigh (evidence count x skill universe) pairs in one pass and the
# chain of thought grows accordingly: measured at 80-300s for 12 units versus about
# 15s for a batch of 4, so batching plus concurrency turns this stage from hundreds
# of seconds into tens. Defaults to 0 to keep the existing recall behaviour: a split
# input gives the model a different context and recall may not match item for item,
# so enabling it is an explicit deployment decision that needs its own acceptance.
LLM_SELECTOR_BATCH_SIZE=0
LLM_SELECTOR_PARALLELISM=4

# Frozen Dev threshold on [0,1] verified_fit. Missing value stays NOT_CALIBRATED.
MATCHING_DECISION_THRESHOLD=0.380952

# Frontend origins: exact scheme/host/port, comma separated, no trailing slash or *.
# Restart the backend after changes. Legacy CORS_ORIGINS is used only if this is unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Candidate request controls
CANDIDATE_REQUEST_TIMEOUT=900
MAX_RESUME_BYTES=10485760
